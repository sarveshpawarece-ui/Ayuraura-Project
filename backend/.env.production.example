# ==============================================================================
# AAYURAURA BACKEND PRODUCTION ENVIRONMENT CONFIGURATION
# Copy or set these environment variables in your production host (e.g. Render/AWS/Railway)
# ==============================================================================

# 1. Core API & Security (REQUIRED)
PROJECT_NAME="Aayuraura Backend"
SECRET_KEY="generate_a_cryptographically_secure_random_32_character_string"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# 2. Database Connection (REQUIRED FOR POSTGRESQL PRODUCTION)
# Set USE_SQLITE_DEV=false to enforce production PostgreSQL connection
USE_SQLITE_DEV=false
DATABASE_URL="postgresql+asyncpg://db_user:db_password@db_host:5432/aayuraura_prod"

# If using local/demo SQLite instead of PostgreSQL:
# USE_SQLITE_DEV=true

# 3. Cross-Origin Resource Sharing (CORS)
# Comma-separated allowed frontend origins (Vercel *.vercel.app domains are allowed automatically)
CORS_ORIGINS="https://aayuraura.vercel.app,https://yourcustomdomain.com"

# 4. AI Ecosystem Integration (Optional - enables real-time Gemini LLM features)
# GEMINI_API_KEY="AIzaSyYourGeminiApiKeyHere"

# 5. Object Storage (Optional - defaults to local directory if unconfigured)
# MINIO_ENDPOINT="s3.amazonaws.com"
# MINIO_ACCESS_KEY="your_access_key"
# MINIO_SECRET_KEY="your_secret_key"
# MINIO_BUCKET_NAME="aayuraura-production-uploads"
# MINIO_SECURE=true

# 6. SMTP Email & Two-Step Verification (REQUIRED FOR PRODUCTION 2FA)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-organization-email@gmail.com"
SMTP_PASSWORD="your-secure-app-password"
SMTP_FROM_EMAIL="noreply@yourdomain.com"
SMTP_FROM_NAME="Aayuraura Security"
SMTP_TLS=true
SMTP_SSL=false
REQUIRE_OTP_LOGIN=true
OTP_EXPIRATION_MINUTES=5

