# ==============================================================================
# Aayuraura Backend — Production Environment Template
# ==============================================================================
# DO NOT commit real secrets or credentials to source control.
# Copy these keys into your Render (or hosting provider) Environment Dashboard.
# ==============================================================================

# Core Application Settings
PROJECT_NAME="Aayuraura Backend"
API_V1_STR="/api/v1"
ENVIRONMENT="production"

# Cryptographic Secret Key (MUST be set to a secure, random 64-character string in production)
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY="replace-with-a-secure-random-64-character-hex-string"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (Managed PostgreSQL on Render or Neon)
# Enforce production PostgreSQL — disable SQLite fallback
USE_SQLITE_DEV=false

# Full async connection string provided by hosting provider
# Format: postgresql+asyncpg://<username>:<password>@<host>:<port>/<database>
DATABASE_URL="postgresql+asyncpg://ayuraura_user:REPLACE_WITH_DB_PASSWORD@dpg-xxxx.render.com/ayuraura_db"

# CORS Allowed Origins (Comma-separated list of production frontend origins)
# Example: https://aayuraura.in,https://aayuraura.vercel.app
CORS_ORIGINS="https://aayuraura.in,https://aayuraura.vercel.app"

# Python Runtime Configuration
PYTHON_VERSION="3.11.9"

# Google OAuth 2.0 / Google Identity Services (Backend ID Token Validation)
GOOGLE_CLIENT_ID="replace-with-your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="replace-with-your-google-client-secret"

# SMTP Email & Two-Step Verification (2FA OTP)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="noreply@aayuraura.in"
SMTP_PASSWORD="replace-with-your-smtp-app-password"
SMTP_FROM_EMAIL="noreply@aayuraura.in"
SMTP_FROM_NAME="Aayuraura Security"
SMTP_TLS=true
SMTP_SSL=false
REQUIRE_OTP_LOGIN=true
OTP_EXPIRATION_MINUTES=5

# Object Storage (Cloudflare R2 or AWS S3 Compatible) [Optional]
MINIO_ENDPOINT="replace-with-r2-account-id.r2.cloudflarestorage.com"
MINIO_ACCESS_KEY="replace-with-r2-access-key-id"
MINIO_SECRET_KEY="replace-with-r2-secret-access-key"
MINIO_BUCKET_NAME="aayuraura-production-uploads"
MINIO_SECURE=true
