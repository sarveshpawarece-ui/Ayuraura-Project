# AyurSetu Environment Configuration

# Backend Environment Variables
PROJECT_NAME="AyurSetu Backend"
API_V1_STR="/api/v1"
SECRET_KEY="ayursetu-sih2k26-secret-key-change-in-production-32bytes"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# PostgreSQL Database Configuration
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432
POSTGRES_USER="ayursetu_user"
POSTGRES_PASSWORD="ayursetu_password"
POSTGRES_DB="ayursetu_db"

# MinIO / S3 Object Storage
MINIO_ENDPOINT="localhost:9000"
MINIO_ACCESS_KEY="minioadmin"
MINIO_SECRET_KEY="minioadmin"
MINIO_BUCKET_NAME="ayursetu-uploads"

# SMTP Email & Two-Step Verification (2FA OTP)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@example.com"
SMTP_PASSWORD="your-app-password"
SMTP_FROM_EMAIL="noreply@aayuraura.in"
SMTP_FROM_NAME="Aayuraura Security"
SMTP_TLS=true
SMTP_SSL=false
REQUIRE_OTP_LOGIN=true
OTP_EXPIRATION_MINUTES=5

# Google Sign-In & OAuth 2.0 / OpenID Connect
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Frontend Environment Variables
NEXT_PUBLIC_API_BASE_URL="http://localhost:8000/api/v1"
NEXT_PUBLIC_APP_NAME="Aayuraura"
NEXT_PUBLIC_GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"

