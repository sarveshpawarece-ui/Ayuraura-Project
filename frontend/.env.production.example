# ==============================================================================
# Aayuraura Frontend — Production Environment Template
# ==============================================================================
# DO NOT commit real secrets or credentials to source control.
# Copy these keys into your Vercel (or hosting provider) Environment Dashboard.
# ==============================================================================

# Backend API Endpoint (Points to the live production FastAPI backend)
# Example with custom domain: https://api.aayuraura.in/api/v1
# Example with Render URL:    https://aayuraura-backend.onrender.com/api/v1
NEXT_PUBLIC_API_BASE_URL="https://api.aayuraura.in/api/v1"

# Application Brand Name
NEXT_PUBLIC_APP_NAME="Aayuraura"

# Google Sign-In Client ID (Google Identity Services)
# MUST match the Authorized JavaScript Origins configured in Google Cloud Console
NEXT_PUBLIC_GOOGLE_CLIENT_ID="replace-with-your-google-client-id.apps.googleusercontent.com"
